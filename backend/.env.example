# Chat App Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite+aiosqlite:///./chat.db

# JWT Configuration  
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Push notifications (FCM - Firebase Cloud Messaging)
# Path to the service account JSON downloaded from Firebase/Google Cloud, OR
# the JSON contents inline in FCM_SERVICE_ACCOUNT_JSON.
FCM_PROJECT_ID=your-fcm-project-id
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# Push notifications (APNs - Apple Push Notification Service)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.example.chatapp
APNS_AUTH_KEY_FILE=
